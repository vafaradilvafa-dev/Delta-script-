local function setFpsCap(value)
    CurrentFpsCap = value
    local ok = pcall(function()
        setfpscap(value)
    end)
    if ok then
        notify("Batas FPS: " .. (value >= 9999 and "No Cap" or tostring(value)))
    else
        notify("setfpscap tidak didukung executor ini")
    end
end

local function cleanMemory()
    local removed = 0
    for _, v in pairs(workspace:GetDescendants()) do
        pcall(function()
            if v:IsA("Message") or v:IsA("Hint") then
                v:Destroy()
                removed = removed + 1
            end
        end)
    end
    pcall(collectgarbage, "collect")
    notify("Memori dibersihkan (" .. removed .. " sampah dihapus)")
end

