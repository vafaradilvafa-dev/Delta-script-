local function notify(text)
    print("[Delta Anti-Lag] " .. tostring(text))
    if not notifyFrame or not NotifyLabel then return end
    notifyToken = notifyToken + 1
    local token = notifyToken
    NotifyLabel.Text = tostring(text)
    notifyFrame.Visible = true
    notifyFrame.BackgroundTransparency = 0.15
    NotifyLabel.TextTransparency = 0
    task.delay(2.5, function()
        if token == notifyToken then
            pcall(function()
                TweenService:Create(notifyFrame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
                TweenService:Create(NotifyLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
            end)
            task.wait(0.45)
            if token == notifyToken then
                notifyFrame.Visible = false
            end
        end
    end)
end

