local function serverHop()
    notify("Mencari server paling sepi...")
    task.spawn(function()
        local ok, err = pcall(function()
            local http = http_request or request or (http and http.request)
            if not http then error("fitur HTTP tidak tersedia") end
            local placeId  = game.PlaceId
            local myJobId  = game.JobId
            local bestId   = nil
            local bestCount = math.huge
            local cursor   = ""
            for _ = 1, 4 do
                local url = "https://games.roblox.com/v1/games/" .. tostring(placeId)
                    .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end
                local res = http({ Url = url, Method = "GET" })
                if not res or not res.Body then error("respons HTTP kosong") end
                local data = HttpService:JSONDecode(res.Body)
                for _, s in pairs(data.data or {}) do
                    local count = s.playing or 0
                    if s.id ~= myJobId and count >= 1 and count < bestCount then
                        bestId = s.id
                        bestCount = count
                    end
                end
                cursor = data.nextPageCursor or ""
                if bestId or cursor == "" then break end
            end
            if bestId then
                notify("Ditemukan server (" .. bestCount .. " pemain). Melompat...")
                task.wait(0.6)
                TeleportService:Teleport(placeId, Players.LocalPlayer)
            else
                notify("Tidak ada server sepi yang ditemukan")
            end
        end)
        if not ok then
            notify("Server hop gagal: " .. tostring(err))
        end
    end)
end

