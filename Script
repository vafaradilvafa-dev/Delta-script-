local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

-- geser (drag) untuk menu dan tombol melayang, mendukung HP
local function makeDraggable(handle, target)
    local dragging  = false
    local dragInput = nil
    local dragStart = nil
    local startPos  = nil
    local moved     = false

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            moved     = false
            dragStart = input.Position
            startPos  = target.Position
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    table.insert(Conns, UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if math.abs(delta.X) + math.abs(delta.Y) > 6 then moved = true end
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    table.insert(Conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return function() return moved end
end

-- =================================================================
-- APLIKASI PER-INSTANCE (dengan cache biar bisa dikembalikan)
-- =================================================================
local function applyToPart(v)
    if texCache[v] then return end
    pcall(function()
        texCache[v] = { Material = v.Material, Reflectance = v.Reflectance }
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
    end)
    pcall(function()
        if v:IsA("MeshPart") then
            texCache[v].TextureID = v.TextureID
            v.TextureID = ""
        end
    end)
end

local function applyToDecal(v)
    if texCache[v] then return end
    pcall(function()
        texCache[v] = { Transparency = v.Transparency }
        v.Transparency = 1
    end)
end

local function applyToSurface(v)
    if texCache[v] then return end
    pcall(function()
        texCache[v] = { Parent = v.Parent }
        v.Parent = nil
    end)
end

local function applyToEmitter(v)
    if particleCache[v] ~= nil then return end
    pcall(function()
        particleCache[v] = v.Enabled
        v.Enabled = false
    end)
end

local function applyToSound(v)
    if soundCache[v] ~= nil then return end
    pcall(function()
        soundCache[v] = v.Volume
        v.Volume = 0
    end)
end

local function cachePostFx(v)
    if postFxCache[v] ~= nil then return end
    pcall(function()
        postFxCache[v] = { Enabled = v.Enabled }
        v.Enabled = false
    end)
end

local function cacheSky(v)
    if skyCache[v] ~= nil then return end
    pcall(function()
        skyCache[v] = { Parent = v.Parent }
        v.Parent = nil
    end)
end

local function cacheAtmosphere(v)
    if skyCache[v] ~= nil then return end
    pcall(function()
        skyCache[v] = { Density = v.Density }
        v.Density = 0
    end)
end

local function restoreCache(cache)
    for v, data in pairs(cache) do
        pcall(function()
            if data.Enabled ~= nil then v.Enabled = data.Enabled end
            if data.Density ~= nil then v.Density = data.Density end
            if data.Parent ~= nil then v.Parent = data.Parent end
        end)
    end
end

local function isEmitter(v)
    return v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
        or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")
end

-- dipanggil untuk setiap instance baru yang muncul di workspace
local function onInstanceAdded(v)
    if not Running or not v then return end
    pcall(function()
        if Config.Textures then
            if v:IsA("BasePart") and not v:IsA("Terrain") then
                applyToPart(v)
            elseif v:IsA("Decal") then
                applyToDecal(v)
            elseif v:IsA("SurfaceAppearance") then
                applyToSurface(v)
            end
        end
        if Config.Particles and isEmitter(v) then
            applyToEmitter(v)
        end
        if Config.Sounds and v:IsA("Sound") then
            applyToSound(v)
        end
    end)
end

local function hookNewInstances()
    if descConn or not Running then return end
    descConn = workspace.DescendantAdded:Connect(function(v)
        task.defer(onInstanceAdded, v)
    end)
    table.insert(Conns, descConn)

    lightConn = Lighting.ChildAdded:Connect(function(v)
        task.defer(function()
            if not Running or not v then return end
            pcall(function()
                if v:IsA("PostEffect") and Config.Particles then
                    cachePostFx(v)
                elseif v:IsA("Sky") and Config.Sky then
                    cacheSky(v)
                elseif v:IsA("Atmosphere") and Config.Sky then
                    cacheAtmosphere(v)
                end
            end)
        end)
    end)
    table.insert(Conns, lightConn)
end

-- =================================================================
-- FITUR UTAMA (toggle ON/OFF)
-- =================================================================
local function applyTextures(on)
    if on then
        for _, v in pairs(workspace:GetDescendants()) do
            pcall(function()
                if v:IsA("BasePart") and not v:IsA("Terrain") then
                    applyToPart(v)
                elseif v:IsA("Decal") then
                    applyToDecal(v)
                elseif v:IsA("SurfaceAppearance") then
                    applyToSurface(v)
                end
            end)
        end
        hookNewInstances()
    else
        for v, data in pairs(texCache) do
            pcall(function()
                if data.Material then
                    v.Material = data.Material
                    v.Reflectance = data.Reflectance
                end
                if data.TextureID ~= nil then v.TextureID = data.TextureID end
                if data.Transparency ~= nil then v.Transparency = data.Transparency end
                if data.Parent ~= nil then v.Parent = data.Parent end
            end)
        end
        texCache = {}
    end
end

local function applyParticles(on)
    if on then
        for _, v in pairs(workspace:GetDescendants()) do
            pcall(function()
                if isEmitter(v) then applyToEmitter(v) end
            end)
        end
        hookNewInstances()
    else
        for v, state in pairs(particleCache) do
            pcall(function() v.Enabled = state end)
        end
        particleCache = {}
    end
end

local function applyLightingEffects(on)
    if on then
        for _, v in pairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("PostEffect") then cachePostFx(v) end
            end)
        end
    else
        restoreCache(postFxCache)
        postFxCache = {}
    end
end

local function applyShadows(on)
    pcall(function()
        if lightingPropCache == nil then
            lightingPropCache = { GlobalShadows = Lighting.GlobalShadows }
        end
        if on then
            Lighting.GlobalShadows = false
        else
            Lighting.GlobalShadows = lightingPropCache.GlobalShadows
        end
    end)
end

local function applyGrass(on)
    if not Terrain then return end
    pcall(function()
        if terrainCache == nil then
            terrainCache = { Decoration = Terrain.Decoration }
        end
        if on then
            Terrain.Decoration = false
        else
            Terrain.Decoration = terrainCache.Decoration
        end
    end)
end

local function applyWater(on)
    if not Terrain then return end
    pcall(function()
        if terrainCache == nil then terrainCache = {} end
        if terrainCache.WaterWaveSize == nil then
            terrainCache.WaterWaveSize     = Terrain.WaterWaveSize
            terrainCache.WaterWaveSpeed    = Terrain.WaterWaveSpeed
            terrainCache.WaterReflectance  = Terrain.WaterReflectance
            terrainCache.WaterTransparency = Terrain.WaterTransparency
        end
        if on then
            Terrain.WaterWaveSize     = 0
            Terrain.WaterWaveSpeed    = 0
            Terrain.WaterReflectance  = 0
            Terrain.WaterTransparency = 1
        else
            Terrain.WaterWaveSize     = terrainCache.WaterWaveSize
            Terrain.WaterWaveSpeed    = terrainCache.WaterWaveSpeed
            Terrain.WaterReflectance  = terrainCache.WaterReflectance
            Terrain.WaterTransparency = terrainCache.WaterTransparency
        end
    end)
end

local function applySky(on)
    if on then
        for _, v in pairs(Lighting:GetChildren()) do
            pcall(function()
                if v:IsA("Sky") then
                    cacheSky(v)
                elseif v:IsA("Atmosphere") then
                    cacheAtmosphere(v)
                end
            end)
        end
        hookNewInstances()
    else
        restoreCache(skyCache)
        skyCache = {}
    end
end

local function applySounds(on)
    if on then
        for _, v in pairs(workspace:GetDescendants()) do
            pcall(function()
                if v:IsA("Sound") then applyToSound(v) end
            end)
        end
        for _, v in pairs(SoundService:GetDescendants()) do
            pcall(function()
                if v:IsA("Sound") then applyToSound(v) end
            end)
        end
        hookNewInstances()
    else
        for v, vol in pairs(soundCache) do
            pcall(function() v.Volume = vol end)
        end
        soundCache = {}
    end
end

local function applyLowGfx(on)
    pcall(function()
        if on then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
        end
    end)
    pcall(function()
        local ugs = UserSettings():GetService("UserGameSettings")
        if on then
            ugs.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        else
            ugs.SavedQualityLevel = Enum.SavedQualitySetting.Automatic
        end
    end)
end

local function applyFullbright(on)
    pcall(function()
        if on then
            Lighting.Brightness = 2.5
            Lighting.ClockTime = 14
            Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 140)
        else
            Lighting.Brightness = 2
            Lighting.ClockTime = 12
            Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        end
    end)
end

local function applyNoFog(on)
    pcall(function()
        if fogCache == nil then
            fogCache = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart }
        end
        if on then
            Lighting.FogEnd = 1e9
            Lighting.FogStart = 0
        else
            Lighting.FogEnd = fogCache.FogEnd
            Lighting.FogStart = fogCache.FogStart
        end
    end)
end

local function applyAntiAFK(on)
    if on then
        if not afkConn then
            afkConn = LocalPlayer.Idled:Connect(function()
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end)
            end)
            table.insert(Conns, afkConn)
        end
    else
        if afkConn then
            pcall(function() afkConn:Disconnect() end)
            afkConn = nil
        end
    end
end

